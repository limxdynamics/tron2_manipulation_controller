          <Script code=" @RobotState:='ST_DAMPING' "/>
          <atc_damping/>
        </Sequence>
      </Precondition>
      <Precondition if="@RobotEvent=='EV_STAIR' && @RobotState=='ST_WALKING'" else="FAILURE">
