      </Precondition>
      <Precondition if="@RobotEvent=='EV_CRIT_LOW_BAT' && (@RobotState=='ST_WALKING' || @RobotState=='ST_STAIR')" else="FAILURE">
        <Sequence>
          <Script code=" @RobotState:='ST_SITTING' "/>
          <atc_sit/>
        </Sequence>
