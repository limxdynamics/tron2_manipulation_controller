          <Script code=" @RobotState:='ST_STAIR' "/>
          <atc_stair/>
        </Sequence>
      </Precondition>
      <Precondition if="@RobotEvent=='EV_STAIR' && @RobotState=='ST_STAIR'" else="FAILURE">
        <Sequence>
          <Script code=" @RobotState:='ST_WALKING' "/>
          <atc_walk/>
